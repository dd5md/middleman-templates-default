<!--Container-->
<div class='mui-container' style='margin-top: -64px;'>
  <div class='mdc-layout-grid'>
    <div class='mdc-layout-grid__inner'>
      <!--Span-6-->
      <div class='mdc-layout-grid__cell--span-6'>
        <!--Card-->
        <div class='mdc-card'>
          <!--Primary-Action-->
          <div class='mdc-card__primary-action'>
            <!--Media-->
            <div class='mdc-card__media mdc-card__media--16-9' id='my-media_1'></div>
            <!--Divider-->
            <%= component :divider_no_mdc %>
            <!--Content-->
            <div class='mdc-card__content'>
              <!--Subheader-->
              <h3 class='mdc-card__subheader'>Sequenzer RX/TX Amplifier</h3>
              <!--Header-->
              <h4 class='mdc-card__header'>by DD[<b>5</b>]MD</h4>
              <!--Description-->
              <p class='mdc-card__description'>Visit ten places on our planet that are undergoing the biggest changes today. Visit ten places on our planet that are undergoing the biggest changes today. Visit ten places on our planet.</p>
            </div>
          </div>
          <!--Divider-->
          <%= component :divider_no_mdc %>
          <!--Actions-->
          <div class='mdc-card__actions bg_actions'>
            <!--Action-Buttons-->
            <div class='mdc-card__action-buttons'>
              <!--Link-->
              <a href='/sequenzer/'>
                <!--Button-->
                <button class='mdc-button mdc-button--raised mdc-card__action mdc-card__action--button bg_button'>
                <i class='material-icons mdc-button__icon'>link</i>
                <span class='mdc-button__label'>More</span>
                </button>
              </a>
            </div>
          </div>
        </div>
      </div>
